;;;; scripts/build-image.lisp -- save a client's server as an SBCL executable
;;;; image (fast start for a load suite and its restarts).
;;;; Usage: sbcl --load scripts/build-image.lisp OUT-DIR CLIENT
;;;; CLIENT is a client system on ASDF's source registry.  Writes
;;;; OUT-DIR/CLIENT-server.image and OUT-DIR/CLIENT-server, a launcher that sets
;;;; the foreign-library path and execs the image (so the launcher's PID is the
;;;; server's PID).

(load (merge-pathnames "setup.lisp" *load-truename*))
(in-package #:tun-build)

(defparameter *out* (uiop:ensure-directory-pathname (or (second sb-ext:*posix-argv*) ".build/pressure/")))
(defparameter *client* (or (third sb-ext:*posix-argv*) ""))
(unless (and (plusp (length *client*))
             (every (lambda (c) (or (lower-case-p c) (digit-char-p c) (char= c #\-))) *client*))
  (format t "~&;; usage: build-image.lisp OUT-DIR CLIENT, not client ~s~%" *client*)
  (exit-with 2))
(ensure-directories-exist *out*)

(load-quietly "alexandria" "bordeaux-threads" "cl-base64" "cl-ppcre" "closer-mop" "com.inuoe.jzon"
              "hunchentoot" "ironclad" "sqlite" "cl-postgres" "swank")
(let ((warnings (compile-strictly (list "tun" *client*))))
  (when warnings
    (format t "~&;; FAIL: ~d warning(s)~%~{;;   ~a~%~}" (length warnings) warnings)
    (exit-with 2)))

(defun git-revision (directory &rest paths)
  "Short HEAD revision of the repository at DIRECTORY, with -dirty when PATHS
(relative to DIRECTORY) have uncommitted changes."
  (let* ((root (namestring directory))
         (rev (ignore-errors (uiop:run-program (list "git" "-C" root "rev-parse" "--short=12" "HEAD")
                                               :output '(:string :stripped t))))
         (dirty (ignore-errors (uiop:run-program (list* "git" "-C" root "status" "--porcelain" "--" paths)
                                                 :output '(:string :stripped t)))))
    (if rev (format nil "~a~:[~;-dirty~]" rev (and dirty (plusp (length dirty)))) "unknown")))

;; introspect_runtime's build revisions (core.md §8.2), fixed in the image: the
;; client's from its own directory, which may be in another repository than
;; Tun.  A tree without git (a copy) is given its revisions by the caller.
(defun given (variable)
  (let ((value (sb-ext:posix-getenv variable))) (and value (plusp (length value)) value)))
(setf (symbol-value (find-symbol "*CORE-REVISION*" "TUN.INTROSPECTION"))
      (or (given "TUN_BUILD_CORE_REVISION")
          (git-revision *root* "src" "tun.asd"))
      (symbol-value (find-symbol "*CLIENT-REVISION*" "TUN.INTROSPECTION"))
      (or (given "TUN_BUILD_CLIENT_REVISION")
          (git-revision (asdf:system-source-directory *client*) ".")))
;; ... and each module's (introspect_runtime.modules).
(setf (symbol-value (find-symbol "*MODULE-REVISIONS*" "TUN.CORE"))
      (loop for module in (funcall (find-symbol "ALL-MODULES" "TUN.CORE"))
            for name = (funcall (find-symbol "MODULE-NAME" "TUN.CORE") module)
            collect (cons name (or (given (format nil "TUN_BUILD_MODULE_REVISION_~:@(~a~)" name))
                                   (git-revision *root* (format nil "modules/~a" name))))))

(let* ((name *client*)
       (launcher (merge-pathnames (format nil "~a-server" name) *out*))
       (image (merge-pathnames (format nil "~a-server.image" name) *out*))
       (class (client-application-class *client*)))
  (with-open-file (out launcher :direction :output :if-exists :supersede)
    (format out "#!/usr/bin/env bash~%# Generated by scripts/build-image.lisp: runs the saved image.~%~
                 export LD_LIBRARY_PATH='~a'~%~
                 exec '~a' ${TUN_RUNTIME_OPTIONS:---dynamic-space-size 2048} --end-runtime-options \"$@\"~%"
            (or (sb-ext:posix-getenv "LD_LIBRARY_PATH") "")
            (namestring image)))
  (sb-posix:chmod (namestring launcher) #o755)
  (format t "~&;; saving ~a~%" image)
  (finish-output)
  (sb-ext:save-lisp-and-die
   image
   :executable t
   :save-runtime-options nil
   :toplevel (lambda ()
               (sb-ext:disable-debugger)
               (funcall (find-symbol "MAIN" "TUN.RUNTIME") class :name name))))
