#!/usr/bin/env python3
"""Recompute one unlocked order through its public, audited update operation."""
import argparse
import json
import os
import urllib.request

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--url", required=True)
parser.add_argument("--order", required=True)
args = parser.parse_args()


def headers():
    """An access token from TUN_TOKEN (spec/auth.md 3.2), else the claim a
    server started with --claimed-identity takes."""
    token = os.environ.get("TUN_TOKEN")
    if token:
        return {"Content-Type": "application/json", "Authorization": "Bearer " + token}
    return {"Content-Type": "application/json", "X-Tun-Actor": "admin:recompute"}



def call(name, arguments):
    request = urllib.request.Request(
        args.url.rstrip("/") + "/mcp",
        headers=headers(),
        data=json.dumps({"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {
            "name": name, "arguments": arguments}}).encode(),
    )
    result = json.loads(urllib.request.urlopen(request, timeout=60).read())["result"]
    payload = json.loads(result["content"][0]["text"])
    if result.get("isError"):
        raise SystemExit(json.dumps(payload, ensure_ascii=False))
    return payload


order = call("orders_get", {"id": args.order})
result = call("orders_update", {"id": args.order, "revision": order["revision"]})
print(json.dumps(result, ensure_ascii=False, indent=2))
