#!/usr/bin/env bash
# bin/repl-setup -- write .build/repl-setup.lisp, which lets a plain SBCL 2.6.4
# outside `nix develop` (an editor's or an agent harness's REPL) load Tun from
# this checkout with the dev shell's libraries:
#   (load "/path/to/tun/.build/repl-setup.lisp")
#   (asdf:load-system "test-client")
# Compiled files go to .build/repl-fasl/, apart from bin/build's.  Run it
# again after the flake's nixpkgs moves.  The strict gates stay bin/build and
# bin/test inside `nix develop`.
set -euo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
out="$here/.build/repl-setup.lisp"
mkdir -p "$here/.build"
# The dev shell's SBCL wrapper sets these variables for itself only.
env_of() {
  nix develop "$here" -c sbcl --noinform --non-interactive --no-userinit --no-sysinit \
    --eval "(write-string (or (sb-ext:posix-getenv \"$1\") \"\"))" 2>/dev/null
}
ASDF_FASL="$(env_of ASDF)" REGISTRY="$(env_of CL_SOURCE_REGISTRY)" LIBS="$(env_of LD_LIBRARY_PATH)" \
ROOT="$here/" OUT="$out" \
python3 - <<'PY'
import os
root, out = os.environ["ROOT"], os.environ["OUT"]
dirs = [d.rstrip("/") for d in os.environ["REGISTRY"].split(":") if d]
q = lambda s: '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'
lines = [";;;; Generated by bin/repl-setup; do not edit or commit.",
         f"(unless (find-package :asdf) (load {q(os.environ['ASDF_FASL'])}))",
         "(asdf:initialize-source-registry",
         " '(:source-registry"]
lines += [f"   (:tree {q(d)})" for d in dirs]
lines += [f"   (:directory {q(root)})",
          f"   (:tree {q(root + 'modules/')})",
          f"   (:directory {q(root + 'tests/client/')})",
          f"   (:tree {q(root + 'clients/')})",
          "   :ignore-inherited-configuration))",
          "(asdf:initialize-output-translations",
          " '(:output-translations"]
# Libraries keep their prebuilt fasls in the store, as in the dev shell.
lines += [f"   ({q(d)} {q(d)})" for d in dirs]
lines += [f"   (t ({q(root + '.build/repl-fasl/')} :implementation))",
          "   :ignore-inherited-configuration))"]
# Native libraries (SQLite) the dev shell puts on the loader path.
libs = [d for d in os.environ["LIBS"].split(":") if d.startswith("/nix/store/")]
lines += ['(asdf:load-system "cffi")',
          "(dolist (dir '(" + " ".join(q(d + "/") for d in libs) + "))",
          '  (pushnew dir (symbol-value (find-symbol "*FOREIGN-LIBRARY-DIRECTORIES*" "CFFI"))',
          "           :test #'equal))"]
open(out, "w", encoding="utf-8").write("\n".join(lines) + "\n")
PY
echo "wrote $out"
