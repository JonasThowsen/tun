#!/usr/bin/env bash
# Run the platform's own tests (spec/tooling.md, "Running the tests"): compile
# Tun, its tests and every client system of the run once, strictly (a
# compiler warning fails the run), then run in parallel, each in a process
# of its own, every child suite of core (no client loaded), the suite of each
# client of scripts/client-systems (the test client in tests/client/, and
# any under clients/) and the tooling checks.  scripts/run-suites runs them.
# Run inside `nix develop`.
# TUN_TEST_SUITES="core test-client" limits the run; TUN_TEST_JOBS="4" runs
# at most four at once (default: the processor count).
# bin/test --only SUITE runs one FiveAM suite of the core tests (such as ui
# or auth), compiled as strictly, in this process and nothing else.
set -euo pipefail
cd "$(dirname "$0")/.."
command -v sbcl >/dev/null || { echo "bin/test: run inside 'nix develop'" >&2; exit 2; }
test_lisp() {
  sbcl --noinform --non-interactive --no-userinit --no-sysinit --load scripts/test.lisp "$@"
}
if [ "${1:-}" = --only ]; then
  [ -n "${2:-}" ] || { echo "usage: bin/test --only SUITE" >&2; exit 2; }
  test_lisp only "$2"
  exit
fi
suites="${TUN_TEST_SUITES:-core $(scripts/client-systems)}"
dir=.build/test
mkdir -p "$dir"

# Shell scripts first: bash parses lazily, so a syntax error in a branch a
# run never takes would otherwise surface only when some run takes it.
for f in bin/* src/cli/template/bin/* scripts/client-systems scripts/run-suites \
         scripts/test-*.sh; do
  if head -1 "$f" | grep -q bash; then
    bash -n "$f" || { echo "bin/test: shell syntax error in $f" >&2; exit 2; }
  fi
done
echo "== shell syntax of bin/, scripts/ and the client templates ok"

# Compile core or a client, its output in .build/test/compile-NAME.log; a
# failure ends the run, since the suites would load what did not compile.
compile() {
  local log="$dir/compile-$1.log" status=0
  test_lisp compile "$1" >"$log" 2>&1 || status=$?
  if [ "$status" -ne 0 ]; then
    cat "$log"
    echo "== FAIL compile $1, from $log"
    exit "$status"
  fi
  grep '^;; compiled' "$log"
}

# Each compile forces what this run has not compiled yet, listed here, so
# core compiles first and a client after it loads the kernel as it is.
rm -f "$dir/compiled"
jobs=(check:test-indent check:test-lint check:test-repl check:test-lisp)
if [[ " $suites " == *" core "* ]]; then
  compile core
  mapfile -t -O "${#jobs[@]}" jobs < <(sed 's/^/core:/' "$dir/core-suites")
fi
for suite in $suites; do
  if [ "$suite" != core ]; then
    compile "$suite"
    jobs+=("client:$suite")
  fi
done

# The store tests run on Postgres too (spec/store.md 5), and a client's
# generated tests open it there (spec/testing.md 1), on a throwaway server
# that lives as long as the run.
status=0
bin/with-postgres scripts/run-suites "${jobs[@]}" || status=$?
echo "== bin/test: ${#jobs[@]} suites in ${SECONDS}s"
exit "$status"
