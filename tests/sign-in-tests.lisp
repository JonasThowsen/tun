;;;; tests/sign-in-tests.lisp -- signing in with an identity provider, and
;;;; the public URL (spec/auth.md 3.4, 3.5 and 4, spec/deploy.md 1), against
;;;; the fake provider of fake-provider.lisp.

(in-package #:tun.tests)

(def-suite sign-in :in core)
(in-suite sign-in)

;;; ------------------------------------------------------------------
;;; Tests

(test a-person-signs-in-by-their-email-and-then-by-their-subject
  (with-test-server (port :identity :authenticated)
    (with-provider (provider)
      (make-account "kari" "person" "employee" "kari@example.no")
      (person-at provider "1001" "Kari@Example.no" "name" "Kari Nordmann")
      (let ((authorization (go-to-provider port)))
        (is (string-prefix-p (provider-url provider "/authorize?") authorization))
        (dolist (part (list "response_type=code" "code_challenge_method=S256"
                            (format nil "client_id=~a" +client-id+)
                            "scope=openid%20email%20profile"
                            (format nil "redirect_uri=~a"
                                    (encoded (format nil "http://127.0.0.1:~d/auth/test/callback"
                                                     port)))))
          (is (search part authorization) "the authorization URL has ~a" part)))
      (multiple-value-bind (status body headers jar) (sign-in-over-provider port)
        (declare (ignore body))
        (is (= 303 status))
        (is (equal (home-location port) (location headers)) "home")
        (is (= 303 (logged-in-status port jar)) "the browser has a session"))
      (let ((request (first (provider-token-requests provider))))
        (is (equal +client-secret+ (cdr (assoc "client_secret" request :test #'equal))))
        (is (= 64 (length (cdr (assoc "code_verifier" request :test #'equal))))))
      (is (equalp #("test") (jget (account-by-name "kari") "sign_in")))
      (is (= 1 (audited "identity_linked")))
      (is (= 1 (audited "login")))
      ;; Linked: the subject decides from now on, whatever the email says.
      (person-at provider "1001" "kari.ny@example.no")
      (is (= 303 (sign-in-over-provider port)))
      (is (= 1 (audited "identity_linked")) "linked once")
      (is (= 2 (audited "login"))))))

(test only-people-with-an-account-get-in
  (with-test-server (port :identity :authenticated)
    (with-provider (provider)
      (person-at provider "2001" "ukjent@example.no")
      (multiple-value-bind (status body) (sign-in-over-provider port)
        (is (= 403 status))
        (is (search "There is no account for ukjent@example.no here" body)))
      (is (null (account-by-name "ukjent")) "signing in makes no account")
      ;; One identity per account and provider: a second Google account
      ;; with the same verified address does not take over the first.
      (make-account "kari" "person" "employee" "kari@example.no")
      (person-at provider "1001" "kari@example.no")
      (is (= 303 (sign-in-over-provider port)))
      (person-at provider "9999" "kari@example.no")
      (is (= 403 (sign-in-over-provider port)))
      ;; A disabled account is refused, linked or not.
      (update-account (account-by-name "kari") "status" "disabled")
      (person-at provider "1001" "kari@example.no")
      (is (= 403 (sign-in-over-provider port)))
      (let ((agent (make-account "robot" "agent" "admin")))
        (declare (ignore agent))
        (person-at provider "3001" "robot@example.no")
        (is (= 403 (sign-in-over-provider port)) "an agent never signs in"))
      (is (= 1 (audited "login")) "only the sign-in that got in is a login")
      (is (<= 4 (count "unauthenticated" (admin-items "introspect_recent" "kind" "rejected")
                       :key (lambda (item) (jget item "error_code")) :test #'equal))
          "refusals are retained as rejected requests"))))

(test an-attempt-is-used-once-in-the-browser-that-started-it
  (with-test-server (port :identity :authenticated)
    (with-provider (provider)
      (make-account "kari" "person" "employee" "kari@example.no")
      (person-at provider "1001" "kari@example.no")
      (flet ((callback-status (callback jar)
               (values (absolute-request callback :jar jar))))
        (multiple-value-bind (authorization jar) (go-to-provider port)
          (let ((callback (come-back authorization)))
            (is (= 400 (callback-status callback (make-instance 'drakma:cookie-jar)))
                "another browser, without the cookie")
            (is (= 400 (callback-status callback jar))
                "the attempt was used up by the refusal")))
        (multiple-value-bind (authorization jar) (go-to-provider port)
          (let ((callback (come-back authorization)))
            (is (= 303 (callback-status callback jar)))
            (is (= 400 (callback-status callback jar)) "used once")))
        (multiple-value-bind (authorization jar) (go-to-provider port)
          (let ((callback (come-back authorization)))
            (advance-clock (1+ tun.auth:+attempt-lifetime+))
            (is (= 400 (callback-status callback jar)) "expired")))
        (multiple-value-bind (authorization jar) (go-to-provider port)
          (declare (ignore authorization))
          (let ((state (drakma:cookie-value
                        (find tun.auth:+sign-in-cookie+ (drakma:cookie-jar-cookies jar)
                              :key #'drakma:cookie-name :test #'string=))))
            (multiple-value-bind (status body)
                (web-request port (format nil "/auth/test/callback?error=access_denied&state=~a"
                                          state)
                             :jar jar)
              (is (= 400 status))
              (is (search "Signing in with Testleverandør was cancelled" body)))))
        (is (= 404 (web-request port "/auth/nope" :method :post)) "an unknown provider")
        (is (= 404 (web-request port "/auth/test")) "starting is a POST")))))

(test every-claim-is-checked
  (with-test-server (port :identity :authenticated)
    (with-provider (provider)
      (make-account "kari" "person" "employee" "kari@example.no")
      (person-at provider "1001" "kari@example.no")
      (let ((now (unix-now provider)))
        (dolist (case (list (list (cons "iss" "https://elsewhere.example") "another issuer")
                            (list (cons "aud" "another-client") "another audience")
                            (list (cons "aud" (vector "another-client" +client-id+))
                                  "a list without azp")
                            (list (cons "exp" (- now 61)) "expired")
                            (list (cons "iat" (+ now 120)) "issued in the future")
                            (list (cons "nonce" "not-ours") "another nonce")
                            (list (cons "email_verified" nil) "an unverified email")
                            (list (cons "email" "") "no email")))
          (destructuring-bind (override what) case
            (setf (provider-overrides provider) (list override))
            (multiple-value-bind (status body) (sign-in-over-provider port)
              (is (= 502 status) "~a is refused" what)
              (is (search "Testleverandør did not answer as expected" body)))))
        (setf (provider-overrides provider)
              (list (cons "aud" (vector "another-client" +client-id+)) (cons "azp" +client-id+)))
        (is (= 303 (sign-in-over-provider port)) "a list with azp passes")
        (setf (provider-overrides provider) (list (cons "exp" (- now 30))))
        (is (= 303 (sign-in-over-provider port)) "within the leeway"))
      (setf (provider-overrides provider) nil
            (provider-failing provider) t)
      (is (= 502 (sign-in-over-provider port)) "the token endpoint refuses the code"))))

(test the-google-preset-is-oidc-with-googles-settings
  (let ((google (make-instance 'tun.auth:google-strategy :client-id "id" :client-secret "s")))
    (is (equal "google" (tun.auth:strategy-name google)))
    (is (equal "Google" (tun.auth:strategy-label google)))
    (is (equal "https://oauth2.googleapis.com/token" (tun.auth:strategy-token-endpoint google)))
    (is (equal "https://accounts.google.com/o/oauth2/v2/auth"
               (tun.auth:strategy-authorization-endpoint google)))
    (is (equal '("https://accounts.google.com" "accounts.google.com")
               (tun.auth:strategy-issuers google))))
  (with-test-server (port :identity :authenticated)
    (with-provider (provider)
      (setf (tun.auth:sign-in-strategies *app*)
            (list (make-instance 'tun.auth:google-strategy
                                 :issuers (list (provider-url provider))
                                 :authorization-endpoint (provider-url provider "/authorize")
                                 :token-endpoint (provider-url provider "/token")
                                 :client-id +client-id+ :client-secret +client-secret+)))
      (make-account "kari" "person" "employee" "kari@example.no")
      (person-at provider "1001" "kari@example.no")
      (let ((authorization (go-to-provider port :path "/auth/google")))
        (is (search "prompt=select_account" authorization))
        (is (search (encoded "/auth/google/callback") authorization)))
      (multiple-value-bind (status body) (web-request port "/login")
        (is (= 200 status))
        (is (search "Sign in with Google" body)))
      (is (= 303 (sign-in-over-provider port :path "/auth/google")))
      (is (equalp #("google") (jget (account-by-name "kari") "sign_in"))
          "linked by the first sign-in"))))

(test the-workos-preset-is-oidc-at-its-authkit-domain
  (flet ((made (&rest settings)
           (tun.auth::make-strategy (list* :workos :client-id "id" :client-secret "s" settings))))
    (let ((workos (made :domain "acme.authkit.app/")))
      (is (equal "workos" (tun.auth:strategy-name workos)))
      (is (equal "https://acme.authkit.app" (tun.auth:strategy-issuer workos)))
      (is (equal "https://acme.authkit.app/oauth2/authorize"
                 (tun.auth:strategy-authorization-endpoint workos)))
      (is (equal "https://acme.authkit.app/oauth2/token" (tun.auth:strategy-token-endpoint workos)))
      (is (null (tun.auth:strategy-button-label workos)) "AuthKit's page offers the choice"))
    (is (equal "https://login.acme.no" (tun.auth:strategy-issuer (made :domain "https://login.acme.no"))))
    (is (search "workos needs :domain" (first (nth-value 1 (made)))))
    (is (search "is not a host name" (first (nth-value 1 (made :domain "ftp://acme.no"))))))
  (with-test-server (port :identity :authenticated)
    (with-provider (provider)
      (setf (tun.auth:sign-in-strategies *app*)
            (list (make-instance 'tun.auth:workos-strategy :domain (provider-url provider)
                                 :client-id +client-id+ :client-secret +client-secret+)))
      (make-account "kari" "person" "employee" "kari@example.no")
      (person-at provider "user_01" "kari@example.no")
      (let ((authorization (go-to-provider port :path "/auth/workos")))
        (is (string-prefix-p (provider-url provider "/oauth2/authorize?") authorization))
        (is (search (encoded "/auth/workos/callback") authorization))
        (is (search "prompt=login" authorization) "AuthKit's page every time"))
      (multiple-value-bind (status body) (web-request port "/login")
        (is (= 200 status))
        (is (search ">Sign in</button>" body) "the button names no provider"))
      (is (= 303 (sign-in-over-provider port :path "/auth/workos")))
      (is (equalp #("workos") (jget (account-by-name "kari") "sign_in")))
      (call-ok "accounts_create" "admin:root" "name" "per" "kind" "person" "role" "viewer"
               "email" "per@example.no" "invite" t)
      (is (search "Sign in with the email address per@example.no:" (third (first (mail-texts))))))))

(test the-login-page-offers-only-the-providers
  (with-test-server (port :identity :authenticated)
    (make-account "kari" "person" "employee" "kari@example.no")
    (with-provider (provider)
      (multiple-value-bind (status body) (web-request port "/login")
        (is (= 200 status))
        (is (search "Sign in with Testleverandør" body))
        (is (not (search "name=\"password\"" body)) "no password field"))
      (is (= 404 (web-request port "/login" :method :post
                              :parameters '(("email" . "kari@example.no")
                                            ("password" . "et langt passord")))))
      (is (= 404 (web-request port (format nil "/password/~a" (make-string 64 :initial-element #\a)))))
      (call-ok "accounts_create" "admin:root" "name" "per" "kind" "person" "role" "viewer"
               "email" "per@example.no" "invite" t)
      (let ((text (third (first (mail-texts)))))
        (is (search "Sign in with Testleverandør and the email address per@example.no:" text)
            "an invitation names the provider")
        (is (search "/login" text)))
      (is (= 303 (sign-in-as port provider "kari@example.no"))))
    (setf (tun.auth:sign-in-strategies *app*) '())
    (multiple-value-bind (status body) (web-request port "/login")
      (is (= 200 status))
      (is (search "no way to sign in" body) "without a provider, nobody gets in"))))

(test a-new-email-unlinks-the-identity
  (with-test-server (port :identity :authenticated)
    (with-provider (provider)
      (let ((kari (make-account "kari" "person" "employee" "kari@example.no")))
        (person-at provider "1001" "kari@example.no")
        (is (= 303 (sign-in-over-provider port)))
        (update-account kari "email" "kari@nytt.example")
        (is (equalp #() (jget (account-by-name "kari") "sign_in")))
        (is (= 403 (sign-in-over-provider port)) "the old address no longer gets in")
        (person-at provider "1002" "kari@nytt.example")
        (is (= 303 (sign-in-over-provider port)) "the new one is linked")
        (update-account kari "email" "kari@nytt.example")
        (is (equalp #("test") (jget (account-by-name "kari") "sign_in"))
            "the same email again keeps the link")))))

(test setup-with-a-provider-makes-the-first-admin
  (with-test-server (port :identity :authenticated)
    (with-provider (provider)
      (let ((setup (setup-path)))
        (multiple-value-bind (status body) (web-request port setup)
          (is (= 200 status))
          (is (search "Continue with Testleverandør" body))
          (is (not (search "name=\"email\"" body)) "the email comes from the provider"))
        (multiple-value-bind (status body)
            (web-request port setup :method :post
                         :parameters '(("name" . "Kari Nordmann")
                                       ("provider" . "test")))
          (is (= 422 status) "the name is checked before leaving")
          (is (search "only lower-case letters" body)))
        (person-at provider "1001" "kari@example.no" "name" "Kari Nordmann")
        (let* ((jar (make-instance 'drakma:cookie-jar))
               (authorization (go-to-provider port :jar jar :path setup
                                              :parameters '(("name" . "kari")
                                                            ("provider" . "test"))))
               (callback (come-back authorization)))
          (multiple-value-bind (status body headers) (absolute-request callback :jar jar)
            (declare (ignore body))
            (is (= 303 status))
            (is (equal "/access" (location headers)))))
        (let ((kari (account-by-name "kari")))
          (is (equal "admin" (jget kari "role")))
          (is (equal "kari@example.no" (jget kari "email")))
          (is (equal "Kari Nordmann" (jget kari "display_name")))
          (is (equalp #("test") (jget kari "sign_in"))))
        (is (= 1 (audited "setup")))
        (is (null (setup-path)) "setup is closed")
        (is (= 404 (web-request port setup)))))))

(define-application unsettled-application ()
  (:sign-in (:google :client-id (:env "TUN_TEST_SIGN_IN_UNSET") :client-secret "s")
            (:oidc :name "x" :client-id "a" :client-secret "b")
            (:twitter)))

(define-application settled-application ()
  (:sign-in (:workos :domain "acme.authkit.app" :client-id "a" :client-secret "b")
            (:google :client-id "a" :client-secret "b")))

(define-application password-application ()
  (:sign-in (:password)))

(test a-strategy-needs-its-settings
  (is (null (uiop:getenv "TUN_TEST_SIGN_IN_UNSET")))
  (let ((problems (tun.auth:sign-in-problems 'unsettled-application)))
    (flet ((mentioned (text)
             (find-if (lambda (problem) (search text problem)) problems)))
      (is (mentioned "google :client-id needs the environment variable TUN_TEST_SIGN_IN_UNSET"))
      (dolist (setting '(":issuer" ":authorization-endpoint" ":token-endpoint" ":label"))
        (is (mentioned (format nil "oidc needs ~a" setting)) "~a is required" setting))
      (is (mentioned ":twitter is not a sign-in strategy"))))
  (is (null (tun.auth:sign-in-problems 'settled-application)))
  (with-test-app (:class 'settled-application)
    (is (equal '("workos" "google")
               (mapcar #'tun.auth:strategy-name (tun.auth:sign-in-strategies *app*)))))
  (is (search "(:password) is no strategy"
              (first (tun.auth:sign-in-problems 'password-application))))
  (is (search "no way to sign in" (first (tun.auth:sign-in-problems 'application)))
      "an application that lists no provider lets nobody in")
  (with-test-app ()
    (is (null (tun.auth:identity-providers *app*)))))

