;;; The public URL

(test the-public-url-keeps-browsers-on-https
  (with-test-server (port :identity :authenticated :public-url "https://tun.example")
    (flet ((get-with (path headers &key (method :get))
             (absolute-request (format nil "http://127.0.0.1:~d~a" port path)
                               :method method :headers headers)))
      (multiple-value-bind (status body headers)
          (get-with "/login?next=1" '(("X-Forwarded-Proto" . "http")))
        (declare (ignore body))
        (is (= 301 status))
        (is (equal "https://tun.example/login?next=1" (location-url headers))))
      (multiple-value-bind (status body headers)
          (get-with "/login" '(("X-Forwarded-Proto" . "https")))
        (declare (ignore body))
        (is (= 200 status))
        (is (equal "max-age=31536000" (cdr (assoc :strict-transport-security headers)))))
      (multiple-value-bind (status body headers) (get-with "/login" '())
        (declare (ignore body))
        (is (= 200 status) "no header: the host itself, not a browser through the proxy")
        (is (null (assoc :strict-transport-security headers))))
      (is (= 200 (get-with "/health" '(("X-Forwarded-Proto" . "http")))))
      (is (/= 301 (get-with "/logout" '(("X-Forwarded-Proto" . "http")) :method :post))
          "only GET and HEAD are moved"))
    (is (search "create one at https://tun.example/setup/"
                (with-output-to-string (out) (tun.auth:announce-setup *app* out))))
    (with-provider (provider)
      (is (search (encoded "https://tun.example/auth/test/callback") (go-to-provider port))
          "the callback is at the public URL"))))
