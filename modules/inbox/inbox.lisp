(defpackage #:tun.inbox
  (:use #:cl #:tun.core #:tun.customers #:tun.orders #:tun.notifications)
  (:local-nicknames (#:ui #:tun.ui))
  (:export #:inquiry #:inquiry-subject #:inquiry-body #:inquiry-from-email
           #:inquiry-from-name #:request-defaults #:inbox-history #:inbound-mail-receive))
(in-package #:tun.inbox)
(define-module inbox (:depends-on customers orders notifications) (:core ">= 2.0.0" "< 3.0")
  (:on-open repair-inbox-receipts)
  (:documentation "Inbound requests and the client-specific request-defaults seam."))
(define-setting "inbox.secret" (:type "secret" :description "Authenticates inbound email."))

(defun inbox-rollback-check (record)
  (declare (ignore record))
  "an inbound request exists; the older deployment lacks its matching, handling and consent rules")
(define-entity inquiry (:id-prefix "hen" :label "Inquiry" :table "inquiries"
                           :indexes (("order_id") ("customer_id") ("message_ref"))
                           :rollback-check inbox-rollback-check)
  ((kind :type (enum "email" "contact_form" "feedback") :input nil :initform "email" :label "Kind")
   (status :type (enum "new" "handled" "dismissed") :input nil :initform "new" :label "Status")
   (from-name :type (string :max 200) :input nil :label "Sender's name")
   (from-email :type (string :max 200) :input nil :label "Sender's email")
   (subject :type (string :max 500) :input nil :label "Subject")
   (body :type (string :max 20000) :input nil :label "Text")
   (received-at :type timestamp :input nil :label "Received")
   (message-ref :type (string :max 500) :input nil :label "Message reference")
   (customer-id :type id :input nil :label "Customer")
   (order-id :type id :input nil :label "Order")
   (match :type (enum "reference" "quote" "customer" "none") :input nil :initform "none"
          :label "Matched by")
   (created-order-id :type id :input nil :label "Draft order")
   (questions :type (list-of (string :max 2000)) :input nil :initform nil :label "Questions")
   (marketing-consent :type boolean :input nil :initform nil :label "Consents to marketing")
   (handled-by :type (string :max 200) :input nil :label "Handled by")
   (handled-at :type timestamp :input nil :label "Handled")
   (note :type (string :max 2000) :input nil :label "Note")
   (request-id :type id :input nil :label "Request ID")))

(defmethod entity->json :around ((item inquiry))
  (mask-quote-credentials (call-next-method) (inquiry-order-id item)))

(defgeneric request-defaults (application inquiry)
  (:method-combination traced-protocol)
  (:method ((application inbox-module) inquiry) (declare (ignore inquiry)) nil))
(register-extension-protocol 'request-defaults "rule" :point "request_defaults"
                            :description "Return a customer/lines/questions draft or null for a new inbound request.")

(defun matching-customers (email)
  (remove-if-not (lambda (customer)
                   (equal email (string-downcase (string-trim '(#\Space #\Tab #\Return #\Newline) (customer-email customer)))))
                 (select 'customer)))
(defun match-request (item)
  ;; References are an authenticated mail convention, never form authority.
  (when (equal (inquiry-kind item) "email")
    (let ((text (format nil "~a~%~a" (inquiry-subject item) (inquiry-body item))) (cursor 0))
      (loop
        (multiple-value-bind (start end starts ends) (cl-ppcre:scan "\\[ref:([^] ]+)\\]" text :start cursor)
          (unless start (return))
          (setf cursor end)
          (let ((order (fetch 'order (subseq text (aref starts 0) (aref ends 0)))))
            (when order
              (setf (inquiry-match item) "reference" (inquiry-order-id item) (entity-id order)
                    (inquiry-customer-id item) (order-customer-id order))
              (return-from match-request item)))))))
  (let* ((customers (matching-customers (string-downcase (inquiry-from-email item))))
         (ids (mapcar #'entity-id customers))
         (order (when ids
                  (find-if (lambda (order)
                             (let ((quote (quote-for-order (entity-id order))))
                               (and quote (equal "awaiting_response" (jget (entity->json quote) "status")))))
                           (select 'order :where `(:and (:in "customer_id" ,ids) (:= "status" "quote_sent"))
                                          :order-by '(("seq" :desc)))))))
    (cond (order (setf (inquiry-customer-id item) (order-customer-id order)
                      (inquiry-order-id item) (entity-id order) (inquiry-match item) "quote"))
          (customers (setf (inquiry-customer-id item) (entity-id (first customers)) (inquiry-match item) "customer"))))
  item)

(defun draft-request (item &key force)
  ;; The seam and every draft write share one savepoint; the enquiry predates it.
  (handler-case
      (multiple-value-bind (customer-id order-id questions)
          (with-transaction (:write)
            (with-actor ((system-actor "inbound"))
              (let ((draft (or (request-defaults *application* item)
                               (when force (jobj "customer" (jobj "name" (or (inquiry-from-name item)
                                 (subseq (inquiry-from-email item) 0 (position #\@ (inquiry-from-email item)))))
                                                 "lines" #() "questions" #())))))
                (when draft
                  (when (typep draft 'operation-error) (error draft))
                  (when (and (hash-table-p draft) (jget draft "error"))
                    (let ((message (jget (jget draft "error") "message")))
                      (if message
                          (fail :invalid-input "~a" message)
                          (fail :invalid-input "request_defaults refused the draft"))))
                  (let* ((args (parse-json (to-json-string (jget draft "customer"))))
                         (customer-id (or (inquiry-customer-id item)
                           (progn
                             (when (and (equal (inquiry-kind item) "contact_form") (inquiry-from-name item))
                               (setf (gethash "name" args) (inquiry-from-name item)))
                             (setf (gethash "email" args) (inquiry-from-email item))
                             (jget (call-tool "customers_create" args) "id"))))
                         (order-args (jobj "customer_id" customer-id "lines" (or (jget draft "lines") #())))
                         (questions (coerce (or (jget draft "questions") #()) 'list)))
                    (when (jget draft "department") (setf (gethash "department" order-args) (jget draft "department")))
                    (let* ((order (call-tool (if (zerop (length (jget order-args "lines"))) "orders_create_request" "orders_create") order-args))
                           (order-id (jget order "id")) (suggestions (invoke 'orders-suggest "id" order-id)))
                      (dolist (suggestion (coerce (or (jget suggestions "items") #()) 'list))
                        (setf questions (append questions (list (jget suggestion "reason")))))
                      (record-order-request order-id (entity-id item) questions (jget draft "delivery"))
                      (when (inquiry-marketing-consent item)
                        (invoke 'customers-set-consent "id" customer-id "marketing_consent" t "source" "contact_form"))
                      (values customer-id order-id questions)))))))
        (when order-id
          (setf (inquiry-customer-id item) customer-id (inquiry-created-order-id item) order-id
                (inquiry-questions item) questions)))
    (error (condition)
      ;; The message is written in the current language, the tenant's, as the
      ;; note it goes into is kept for people to read.
      (let ((message (if (typep condition 'operation-error)
                         (operation-error-message condition)
                         (princ-to-string condition))))
        ;; The refusal passes the inner message on as its text, so it is
        ;; written where the refusal is shown.
        (when force
          (fail :invalid-input "draft not created: ~a"
                (if (typep condition 'operation-error)
                    (operation-error-text condition)
                    message)))
        (let ((note (tr "draft not created: ~a" message)))
          (setf (inquiry-note item) (subseq note 0 (min 2000 (length note))))))))
  item)

(defun thread-request (item order-id &key cancel)
  (let ((order (find-order order-id)))
    (setf (inquiry-order-id item) order-id (inquiry-customer-id item) (order-customer-id order))
    (when cancel
      (tun.workflows:cancel-workflows order-id :kinds '("quote_reminder")
                                                :note (tr "the customer has replied")))
    (publish-notification "customer_reply_received" (entity-id item)
                          (tr "The customer has replied to order ~a." order-id)
                          (format nil "/orders/~a" order-id) "inquiry" (entity-id item) :order-id order-id)))

(defun intake-request (item)
  (match-request item)
  (insert item)
  (if (inquiry-order-id item)
      (thread-request item (inquiry-order-id item) :cancel t)
      (progn (draft-request item)
             (publish-notification "inquiry_received" (entity-id item)
                                   (tr "You have a new inquiry.")
                                   (format nil "/inquiries/~a" (entity-id item)) "inquiry" (entity-id item))))
  (when (and (equal (inquiry-kind item) "contact_form") (inquiry-marketing-consent item)
             (inquiry-customer-id item))
    (let ((customer (fetch! 'customer (inquiry-customer-id item))))
      (unless (and (customer-marketing-consent customer) (equal (customer-consent-source customer) "contact_form"))
        (with-actor ((system-actor "inbound"))
          (invoke 'customers-set-consent "id" (entity-id customer) "marketing_consent" t "source" "contact_form")))))
  (save item))

(define-operation inbound-mail-receive ((from-name :type (string :max 200))
                                        (from-email :type email :required t)
                                        (subject :type (string :max 500) :required t)
                                        (body :type (string :max 20000 :trim nil) :required t)
                                        (received-at :type timestamp) (message-ref :type (string :max 500)))
    (:entity inquiry :kind :create :policy :admin :title "Receive an email")
  (let ((existing (and message-ref (select-one 'inquiry :where `(:= "message_ref" ,message-ref)))))
    (if existing (jobj "inquiry" (entity->json existing) "duplicate" t)
        (let ((item (intake-request (make-instance 'inquiry :from-name from-name
                     :from-email (string-downcase (string-trim '(#\Space #\Tab #\Return #\Newline) from-email)) :subject subject :body body
                     :received-at (or received-at (now)) :message-ref message-ref :request-id *request-id*))))
          (write-system-audit "inbound_mail_receive" "ok" :entity-type "inquiry" :entity-id (entity-id item))
          (jobj "inquiry" (entity->json item) "duplicate" nil)))))

(define-operation inquiries-create ((name :type (string :min 1 :max 120) :required t)
                                      (email :type email :required t) (phone :type (string :max 40))
                                      (message :type (string :max 19500 :trim nil) :required t)
                                      (event-date :type date) (guests :type (integer :min 1))
                                      (marketing-consent :type boolean :schema-required t))
    (:entity inquiry :kind :create :policy :viewer :viewer-mutation t :title "Contact us")
  (unless marketing-consent (fail :invalid-input "consent must be given"))
  ;; The subject and the lines added to the body are in the tenant's
  ;; language, which a client's request_defaults reads.
  (intake-request (make-instance 'inquiry :kind "contact_form" :from-name name :from-email email
                   :subject (tr "Contact form")
                   :body (tr "~a~@[~%Date: ~a~]~@[~%Guests: ~d~]" message
                             (and event-date (date-text event-date)) guests)
                   :received-at (now) :marketing-consent t :request-id *request-id*)))

(define-operation inquiries-list ((status :type (enum "new" "handled" "dismissed"))
                                    (kind :type (enum "email" "contact_form" "feedback"))
                                    (limit :type (integer :min 1 :max 100) :default 20))
    (:entity inquiry :kind :read :policy :employee :title "Inquiries")
  (let ((where (remove nil (list (and status `(:= "status" ,status)) (and kind `(:= "kind" ,kind))))))
    (jobj "items" (jarr (mapcar #'entity->json (select 'inquiry :where (and where `(:and ,@where))
                                                               :order-by '(("seq" :desc)) :limit limit))))))
(define-operation inquiries-get ((id :type (id inquiry) :required t))
    (:entity inquiry :kind :read :policy :employee :title "Read an inquiry") (fetch! 'inquiry id))
(define-operation inquiries-handle ((id :type (id inquiry) :required t)
                                      (action :type (enum "convert" "attach" "dismiss") :required t)
                                      (order-id :type id) (note :type (string :max 2000)))
    (:entity inquiry :kind :update :policy :employee :title "Handle an inquiry")
  (let ((item (fetch! 'inquiry id)))
    (unless (equal (inquiry-status item) "new")
      (fail :invalid-transition "The inquiry has already been handled"))
    (cond ((equal action "attach")
           (unless order-id (fail :invalid-input "Give an order"))
           (thread-request item order-id))
          ((equal action "convert")
           (when (inquiry-created-order-id item)
             (fail :invalid-transition "The inquiry already has an order"))
           (draft-request item :force t)))
    (setf (inquiry-status item) (if (equal action "dismiss") "dismissed" "handled")
          (inquiry-handled-at item) (now) (inquiry-handled-by item) (actor-string *actor*)
          (inquiry-note item) (or note (inquiry-note item)))
    (save item)))

(defun inbox-history (&key order-id customer-id)
  (let ((where (remove nil (list (and order-id `(:= "order_id" ,order-id))
                                 (and customer-id `(:= "customer_id" ,customer-id))))))
    (mapcar (lambda (item)
              (mask-quote-credentials
              (jobj "id" (entity-id item) "kind" "inbound" "inquiry_id" (entity-id item)
                    "order_id" (or (inquiry-order-id item) :null) "customer_id" (or (inquiry-customer-id item) :null)
                    "subject" (inquiry-subject item) "body" (inquiry-body item) "delivery" :null
                    "status" "received" "template" :null "request_id" (inquiry-request-id item)
                    "sent_at" :null "scheduled_at" (format-rfc3339 (inquiry-received-at item))
                    "sender" (jobj "name" (or (inquiry-from-name item) "") "email" (inquiry-from-email item))
                    "recipient" (jobj "name" (or (inquiry-from-name item) "") "email" (inquiry-from-email item))) (inquiry-order-id item)))
            (select 'inquiry :where (and where `(:and ,@where)) :order-by '(("seq" :asc))))))

(defmethod aggregate-order-communication ((app inbox-module) order)
  (let* ((result (call-next-method)) (items (select 'inquiry :where `(:= "order_id" ,(entity-id order))))
         (latest (reduce #'max items :key #'inquiry-received-at :initial-value 0)))
    (setf (gethash "inbound" result) (length items))
    (when (plusp latest) (setf (gethash "last_inbound_at" result) (format-rfc3339 latest)))
    result))
(defmethod customer-erasing ((app inbox-module) customer)
  (call-next-method)
  (dolist (item (select 'inquiry :where `(:= "customer_id" ,(entity-id customer))))
    (setf (inquiry-from-name item) "[slettet]" (inquiry-from-email item) "[slettet]"
          (inquiry-subject item) "[slettet]" (inquiry-body item) "[slettet]")
    (save item) (redact-entity-receipts item)))

(defun request-text-matches-p (pattern text)
  (not (null (cl-ppcre:scan (unicode-text-scanner pattern) text))))
(defun request-postcodes (text)
  (loop with scanner = (unicode-text-scanner "(?<![.\\w-])[0-9]{4}(?![.\\w-])")
        with cursor = 0 for match = (multiple-value-list (cl-ppcre:scan scanner text :start cursor))
        while (first match) collect (subseq text (first match) (second match))
        do (setf cursor (second match))))
(defun trim-request-line (line &optional punctuation)
  (let* ((start (or (position-if-not #'unicode-whitespace-p line) (length line)))
         (end (position-if-not (lambda (character)
                                (or (unicode-whitespace-p character)
                                    (and punctuation (unicode-punctuation-p character)))) line :from-end t)))
    (if (and end (>= end start)) (subseq line start (1+ end)) "")))
(defun request-name (item)
  (let ((lines (cl-ppcre:split "\\r\\n|[\\r\\n]" (inquiry-body item))))
    (loop for rest on lines for line = (trim-request-line (first rest))
          for lower = (string-downcase line)
          do (cond ((member (string-downcase (trim-request-line line t))
                            '("hilsen" "mvh" "vennlig hilsen" "med vennlig hilsen") :test #'equal)
                    (let ((name (find-if (lambda (value) (not (blank-p (trim-request-line value)))) (rest rest))))
                      (when name (return-from request-name (trim-request-line name)))))
                   ((and (> (length lower) 7) (equal "hilsen" (subseq lower 0 6))
                         (unicode-whitespace-p (char lower 6)))
                    (return-from request-name (trim-request-line (subseq line 7))))))
    (subseq (inquiry-from-email item) 0 (position #\@ (inquiry-from-email item)))))
(publish '(request-text-matches-p request-postcodes request-name))
(publish '(request-defaults inquiry inquiry-subject inquiry-body inquiry-from-email inquiry-from-name))
(defun inbound-secret-p (secret)
  "True when SECRET is the inbox's: checked before the body is parsed."
  (let ((expected (with-transaction (:read) (setting-value-at-use "inbox.secret"))))
    (and (stringp secret) (constant-time-string= (sha256-hex secret) (sha256-hex expected)))))

(defun receive-inbound-http (body secret)
  (declare (ignore secret))
  (with-actor ((system-actor "inbound"))
    (values 200 (call-tool "inbound_mail_receive" body))))
(tun.web:register-json-endpoint "/inbound/mail" 'receive-inbound-http :authorize 'inbound-secret-p)

(defun repair-inbox-receipts ()
  "At startup, redact receipts of erased customers' inquiries that still
hold their data (README §9); keys remain deduplicated."
  (with-transaction (:write)
    (dolist (customer (select 'customer :where '(:= "erased" t)))
      (dolist (item (select 'inquiry :where `(:= "customer_id" ,(entity-id customer))))
        (redact-entity-receipts item)))))
