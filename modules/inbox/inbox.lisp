(defpackage #:tun.inbox
  (:use #:cl #:tun.core #:tun.customers #:tun.orders #:tun.notifications)
  (:local-nicknames (#:ui #:tun.ui))
  (:export #:henvendelse #:henvendelse-subject #:henvendelse-body #:henvendelse-from-email
           #:henvendelse-from-name #:request-defaults #:inbox-history #:inbound-mail-receive))
(in-package #:tun.inbox)
(define-module inbox (:depends-on customers orders notifications) (:core ">= 1.20.0" "< 2.0")
  (:on-open repair-inbox-receipts)
  (:documentation "Inbound requests and the client-specific request-defaults seam."))
(define-setting "innboks.hemmelighet" (:type "secret" :description "Autentiserer innkommende e-post."))

(defun inbox-rollback-check (record)
  (declare (ignore record))
  "an inbound request exists; the older deployment lacks its matching, handling and consent rules")
(define-entity henvendelse (:id-prefix "hen" :label "Henvendelse" :table "henvendelser"
                           :indexes (("order_id") ("customer_id") ("message_ref"))
                           :rollback-check inbox-rollback-check)
  ((kind :type (enum "epost" "kontaktskjema" "tilbakemelding") :input nil :initform "epost")
   (status :type (enum "ny" "behandlet" "avvist") :input nil :initform "ny")
   (from-name :type (string :max 200) :input nil)
   (from-email :type (string :max 200) :input nil)
   (subject :type (string :max 500) :input nil)
   (body :type (string :max 20000) :input nil)
   (received-at :type timestamp :input nil)
   (message-ref :type (string :max 500) :input nil)
   (customer-id :type id :input nil)
   (order-id :type id :input nil)
   (match :type (enum "referanse" "tilbud" "kunde" "ingen") :input nil :initform "ingen")
   (created-order-id :type id :input nil)
   (questions :type (list-of (string :max 2000)) :input nil :initform nil)
   (marketing-consent :type boolean :input nil :initform nil)
   (handled-by :type (string :max 200) :input nil)
   (handled-at :type timestamp :input nil)
   (note :type (string :max 2000) :input nil)
   (request-id :type id :input nil)))

(defmethod entity->json :around ((item henvendelse))
  (mask-quote-credentials (call-next-method) (henvendelse-order-id item)))

(defgeneric request-defaults (application henvendelse)
  (:method-combination traced-protocol)
  (:method ((application inbox-module) henvendelse) (declare (ignore henvendelse)) nil))
(register-extension-protocol 'request-defaults "rule" :point "request_defaults"
                            :description "Return a customer/lines/questions draft or null for a new inbound request.")

(defun matching-customers (email)
  (remove-if-not (lambda (customer)
                   (equal email (string-downcase (string-trim '(#\Space #\Tab #\Return #\Newline) (customer-email customer)))))
                 (select 'customer)))
(defun match-request (item)
  ;; References are an authenticated mail convention, never form authority.
  (when (equal (henvendelse-kind item) "epost")
    (let ((text (format nil "~a~%~a" (henvendelse-subject item) (henvendelse-body item))) (cursor 0))
      (loop
        (multiple-value-bind (start end starts ends) (cl-ppcre:scan "\\[ref:([^] ]+)\\]" text :start cursor)
          (unless start (return))
          (setf cursor end)
          (let ((order (fetch 'order (subseq text (aref starts 0) (aref ends 0)))))
            (when order
              (setf (henvendelse-match item) "referanse" (henvendelse-order-id item) (entity-id order)
                    (henvendelse-customer-id item) (order-customer-id order))
              (return-from match-request item)))))))
  (let* ((customers (matching-customers (string-downcase (henvendelse-from-email item))))
         (ids (mapcar #'entity-id customers))
         (order (when ids
                  (find-if (lambda (order)
                             (let ((quote (quote-for-order (entity-id order))))
                               (and quote (equal "awaiting_response" (jget (entity->json quote) "status")))))
                           (select 'order :where `(:and (:in "customer_id" ,ids) (:= "status" "tilbud_sendt"))
                                          :order-by '(("seq" :desc)))))))
    (cond (order (setf (henvendelse-customer-id item) (order-customer-id order)
                      (henvendelse-order-id item) (entity-id order) (henvendelse-match item) "tilbud"))
          (customers (setf (henvendelse-customer-id item) (entity-id (first customers)) (henvendelse-match item) "kunde"))))
  item)

(defun draft-request (item &key force)
  ;; The seam and every draft write share one savepoint; the enquiry predates it.
  (handler-case
      (multiple-value-bind (customer-id order-id questions)
          (with-transaction (:write)
            (with-actor ((system-actor "inbound"))
              (let ((draft (or (request-defaults *application* item)
                               (when force (jobj "customer" (jobj "name" (or (henvendelse-from-name item)
                                 (subseq (henvendelse-from-email item) 0 (position #\@ (henvendelse-from-email item)))))
                                                 "lines" #() "questions" #())))))
                (when draft
                  (when (typep draft 'operation-error) (error draft))
                  (when (and (hash-table-p draft) (jget draft "error"))
                    (fail :invalid-input "~a" (or (jget (jget draft "error") "message") "request_defaults avviste utkastet")))
                  (let* ((args (parse-json (to-json-string (jget draft "customer"))))
                         (customer-id (or (henvendelse-customer-id item)
                           (progn
                             (when (and (equal (henvendelse-kind item) "kontaktskjema") (henvendelse-from-name item))
                               (setf (gethash "name" args) (henvendelse-from-name item)))
                             (setf (gethash "email" args) (henvendelse-from-email item))
                             (jget (call-tool "customers_create" args) "id"))))
                         (order-args (jobj "customer_id" customer-id "lines" (or (jget draft "lines") #())))
                         (questions (coerce (or (jget draft "questions") #()) 'list)))
                    (when (jget draft "department") (setf (gethash "department" order-args) (jget draft "department")))
                    (let* ((order (call-tool (if (zerop (length (jget order-args "lines"))) "orders_create_request" "orders_create") order-args))
                           (order-id (jget order "id")) (suggestions (invoke 'orders-suggest "id" order-id)))
                      (dolist (suggestion (coerce (or (jget suggestions "items") #()) 'list))
                        (setf questions (append questions (list (jget suggestion "reason")))))
                      (record-order-request order-id (entity-id item) questions (jget draft "delivery"))
                      (when (henvendelse-marketing-consent item)
                        (invoke 'customers-set-consent "id" customer-id "marketing_consent" t "source" "kontaktskjema"))
                      (values customer-id order-id questions)))))))
        (when order-id
          (setf (henvendelse-customer-id item) customer-id (henvendelse-created-order-id item) order-id
                (henvendelse-questions item) questions)))
    (error (condition)
      (let* ((message (if (typep condition 'operation-error) (operation-error-message condition) (princ-to-string condition)))
             (note (format nil "utkast ikke opprettet: ~a" message)))
        (when force (fail :invalid-input "~a" note))
        (setf (henvendelse-note item) (subseq note 0 (min 2000 (length note)))))))
  item)

(defun thread-request (item order-id &key cancel)
  (let ((order (find-order order-id)))
    (setf (henvendelse-order-id item) order-id (henvendelse-customer-id item) (order-customer-id order))
    (when cancel
      (tun.workflows:cancel-workflows order-id :kinds '("tilbud_påminnelse") :note "kunden har svart"))
    (publish-notification "kundesvar_mottatt" (entity-id item) (format nil "Kunden har svart på ordre ~a." order-id)
                          (format nil "/orders/~a" order-id) "henvendelse" (entity-id item) :order-id order-id)))

(defun intake-request (item)
  (match-request item)
  (insert item)
  (if (henvendelse-order-id item)
      (thread-request item (henvendelse-order-id item) :cancel t)
      (progn (draft-request item)
             (publish-notification "henvendelse_mottatt" (entity-id item) "Du har fått en ny henvendelse."
                                   (format nil "/henvendelser/~a" (entity-id item)) "henvendelse" (entity-id item))))
  (when (and (equal (henvendelse-kind item) "kontaktskjema") (henvendelse-marketing-consent item)
             (henvendelse-customer-id item))
    (let ((customer (fetch! 'customer (henvendelse-customer-id item))))
      (unless (and (customer-marketing-consent customer) (equal (customer-consent-source customer) "kontaktskjema"))
        (with-actor ((system-actor "inbound"))
          (invoke 'customers-set-consent "id" (entity-id customer) "marketing_consent" t "source" "kontaktskjema")))))
  (save item))

(define-operation inbound-mail-receive ((from-name :type (string :max 200))
                                        (from-email :type email :required t)
                                        (subject :type (string :max 500) :required t)
                                        (body :type (string :max 20000 :trim nil) :required t)
                                        (received-at :type timestamp) (message-ref :type (string :max 500)))
    (:entity henvendelse :kind :create :policy :admin :title "Motta e-post")
  (let ((existing (and message-ref (select-one 'henvendelse :where `(:= "message_ref" ,message-ref)))))
    (if existing (jobj "henvendelse" (entity->json existing) "duplicate" t)
        (let ((item (intake-request (make-instance 'henvendelse :from-name from-name
                     :from-email (string-downcase (string-trim '(#\Space #\Tab #\Return #\Newline) from-email)) :subject subject :body body
                     :received-at (or received-at (now)) :message-ref message-ref :request-id *request-id*))))
          (write-system-audit "inbound_mail_receive" "ok" :entity-type "henvendelse" :entity-id (entity-id item))
          (jobj "henvendelse" (entity->json item) "duplicate" nil)))))

(define-operation henvendelser-create ((name :type (string :min 1 :max 120) :required t)
                                      (email :type email :required t) (phone :type (string :max 40))
                                      (message :type (string :max 19500 :trim nil) :required t)
                                      (event-date :type date) (guests :type (integer :min 1))
                                      (marketing-consent :type boolean :schema-required t))
    (:entity henvendelse :kind :create :policy :viewer :viewer-mutation t :title "Kontakt oss")
  (unless marketing-consent (fail :invalid-input "samtykke må gis"))
  (intake-request (make-instance 'henvendelse :kind "kontaktskjema" :from-name name :from-email email
                   :subject "Kontaktskjema" :body (format nil "~a~@[~%Dato: ~a~]~@[~%Gjester: ~d~]" message
                         (when event-date (format nil "~a.~a.~a" (subseq event-date 8 10) (subseq event-date 5 7) (subseq event-date 0 4))) guests)
                   :received-at (now) :marketing-consent t :request-id *request-id*)))

(define-operation henvendelser-list ((status :type (enum "ny" "behandlet" "avvist"))
                                    (kind :type (enum "epost" "kontaktskjema" "tilbakemelding"))
                                    (limit :type (integer :min 1 :max 100) :default 20))
    (:entity henvendelse :kind :read :policy :employee :title "Henvendelser")
  (let ((where (remove nil (list (and status `(:= "status" ,status)) (and kind `(:= "kind" ,kind))))))
    (jobj "items" (jarr (mapcar #'entity->json (select 'henvendelse :where (and where `(:and ,@where))
                                                               :order-by '(("seq" :desc)) :limit limit))))))
(define-operation henvendelser-get ((id :type (id henvendelse) :required t))
    (:entity henvendelse :kind :read :policy :employee :title "Hent henvendelse") (fetch! 'henvendelse id))
(define-operation henvendelser-handle ((id :type (id henvendelse) :required t)
                                      (action :type (enum "convert" "attach" "dismiss") :required t)
                                      (order-id :type id) (note :type (string :max 2000)))
    (:entity henvendelse :kind :update :policy :employee :title "Behandle henvendelse")
  (let ((item (fetch! 'henvendelse id)))
    (unless (equal (henvendelse-status item) "ny") (fail :invalid-transition "Henvendelsen er allerede behandlet"))
    (cond ((equal action "attach") (unless order-id (fail :invalid-input "Oppgi ordre")) (thread-request item order-id))
          ((equal action "convert")
           (when (henvendelse-created-order-id item) (fail :invalid-transition "Henvendelsen har allerede en ordre"))
           (draft-request item :force t)))
    (setf (henvendelse-status item) (if (equal action "dismiss") "avvist" "behandlet")
          (henvendelse-handled-at item) (now) (henvendelse-handled-by item) (actor-string *actor*)
          (henvendelse-note item) (or note (henvendelse-note item)))
    (save item)))

(defun inbox-history (&key order-id customer-id)
  (let ((where (remove nil (list (and order-id `(:= "order_id" ,order-id))
                                 (and customer-id `(:= "customer_id" ,customer-id))))))
    (mapcar (lambda (item)
              (mask-quote-credentials
              (jobj "id" (entity-id item) "kind" "innkommende" "henvendelse_id" (entity-id item)
                    "order_id" (or (henvendelse-order-id item) :null) "customer_id" (or (henvendelse-customer-id item) :null)
                    "subject" (henvendelse-subject item) "body" (henvendelse-body item) "delivery" :null
                    "status" "mottatt" "template" :null "request_id" (henvendelse-request-id item)
                    "sent_at" :null "scheduled_at" (format-rfc3339 (henvendelse-received-at item))
                    "sender" (jobj "name" (or (henvendelse-from-name item) "") "email" (henvendelse-from-email item))
                    "recipient" (jobj "name" (or (henvendelse-from-name item) "") "email" (henvendelse-from-email item))) (henvendelse-order-id item)))
            (select 'henvendelse :where (and where `(:and ,@where)) :order-by '(("seq" :asc))))))

(defmethod aggregate-order-communication ((app inbox-module) order)
  (let* ((result (call-next-method)) (items (select 'henvendelse :where `(:= "order_id" ,(entity-id order))))
         (latest (reduce #'max items :key #'henvendelse-received-at :initial-value 0)))
    (setf (gethash "inbound" result) (length items))
    (when (plusp latest) (setf (gethash "last_inbound_at" result) (format-rfc3339 latest)))
    result))
(defmethod customer-erasing ((app inbox-module) customer)
  (call-next-method)
  (dolist (item (select 'henvendelse :where `(:= "customer_id" ,(entity-id customer))))
    (setf (henvendelse-from-name item) "[slettet]" (henvendelse-from-email item) "[slettet]"
          (henvendelse-subject item) "[slettet]" (henvendelse-body item) "[slettet]")
    (save item) (redact-entity-receipts item)))

(defun request-text-matches-p (pattern text)
  (not (null (cl-ppcre:scan (unicode-text-scanner pattern) text))))
(defun request-postcodes (text)
  (loop with scanner = (unicode-text-scanner "(?<![.\\w-])[0-9]{4}(?![.\\w-])")
        with cursor = 0 for match = (multiple-value-list (cl-ppcre:scan scanner text :start cursor))
        while (first match) collect (subseq text (first match) (second match))
        do (setf cursor (second match))))
(defun trim-request-line (line &optional punctuation)
  (let* ((start (or (position-if-not #'unicode-whitespace-p line) (length line)))
         (end (position-if-not (lambda (character)
                                (or (unicode-whitespace-p character)
                                    (and punctuation (unicode-punctuation-p character)))) line :from-end t)))
    (if (and end (>= end start)) (subseq line start (1+ end)) "")))
(defun request-name (item)
  (let ((lines (cl-ppcre:split "\\r\\n|[\\r\\n]" (henvendelse-body item))))
    (loop for rest on lines for line = (trim-request-line (first rest))
          for lower = (string-downcase line)
          do (cond ((member (string-downcase (trim-request-line line t))
                            '("hilsen" "mvh" "vennlig hilsen" "med vennlig hilsen") :test #'equal)
                    (let ((name (find-if (lambda (value) (not (blank-p (trim-request-line value)))) (rest rest))))
                      (when name (return-from request-name (trim-request-line name)))))
                   ((and (> (length lower) 7) (equal "hilsen" (subseq lower 0 6))
                         (unicode-whitespace-p (char lower 6)))
                    (return-from request-name (trim-request-line (subseq line 7))))))
    (subseq (henvendelse-from-email item) 0 (position #\@ (henvendelse-from-email item)))))
(publish '(request-text-matches-p request-postcodes request-name))
(publish '(request-defaults henvendelse henvendelse-subject henvendelse-body henvendelse-from-email henvendelse-from-name))
(defun inbound-secret-p (secret)
  "True when SECRET is the inbox's: checked before the body is parsed."
  (let ((expected (with-transaction (:read) (setting-value-at-use "innboks.hemmelighet"))))
    (and (stringp secret) (constant-time-string= (sha256-hex secret) (sha256-hex expected)))))

(defun receive-inbound-http (body secret)
  (declare (ignore secret))
  (with-actor ((system-actor "inbound"))
    (values 200 (call-tool "inbound_mail_receive" body))))
(tun.web:register-json-endpoint "/inbound/mail" 'receive-inbound-http :authorize 'inbound-secret-p)

(defun repair-inbox-receipts ()
  "At startup, redact receipts of erased customers' henvendelser that still
hold their data (README §9); keys remain deduplicated."
  (with-transaction (:write)
    (dolist (customer (select 'customer :where '(:= "erased" t)))
      (dolist (item (select 'henvendelse :where `(:= "customer_id" ,(entity-id customer))))
        (redact-entity-receipts item)))))
