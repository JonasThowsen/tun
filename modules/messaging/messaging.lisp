;;;; messaging.lisp -- immutable message snapshots and public communication operations.
(defpackage #:tun.messaging
  (:use #:cl #:tun.core #:tun.customers #:tun.orders #:tun.inbox #:tun.notifications)
  (:shadow #:message-template)
  (:local-nicknames (#:ui #:tun.ui))
  (:export #:message #:message-order-id #:message-customer-id #:message-template #:message-subject
           #:message-body #:message-scheduled-at #:message-sent-at #:message-status #:message-recipient
           #:message-transport #:fake-message-transport #:deliver-message #:deliver-snapshot #:send-message #:messages-list))
(in-package #:tun.messaging)
(declaim (optimize (safety 3) (debug 2)))
(define-module messaging (:depends-on orders customers notifications inbox) (:core ">= 1.3.0" "< 2.0")
  (:on-open reconcile-outbox repair-message-receipts)
  (:documentation "Data templates, frozen snapshots and one deliberate provider attempt per delivery."))
(define-setting "avsender.navn" (:type "string" :default "Tun" :description "Navnet i utgående e-post."))
(define-setting "avsender.epost" (:type "email" :default "noreply@example.invalid" :description "Avsenderadresse."))
(define-setting "avsender.svar_til" (:type "email" :nullable t :description "Svaradresse, eller avsenderadressen."))
(eval-when (:compile-toplevel :load-toplevel :execute)
  (defclass message-recipient-type (json-type) ()))
(defmethod type->db ((type message-recipient-type) value)
  ;; A staff recipient is stored as plain actor TEXT, the representation an
  ;; older warehouse deployment reads, so its rows stay readable (README §5.5).
  (if (and (stringp value) (parse-actor value)) value (call-next-method)))
(defmethod db->type ((type message-recipient-type) value)
  (handler-case (call-next-method)
    (error (condition)
      (if (and (stringp value) (parse-actor value)) value (error condition)))))
(define-entity template (:embedded t :label "Meldingsmal")
  ((name :type string) (version :type integer) (subject :type string) (text :type string)
   (variables :type json) (manual :type boolean) (marketing :type boolean) (final :type boolean)))
(define-entity message (:label "Melding" :id-prefix "msg" :table "messages" :indexes (("order_id") ("customer_id")))
  ((order-id :type id :input nil) (customer-id :type id :input nil)
   (template :type (string :max 100) :input nil) (version :type integer :input nil :initform 1)
   (kind :type (enum "utgående" "innkommende") :input nil :initform "utgående")
   (subject :type (string :max 1000) :input nil) (body :type (string :max 30000) :input nil)
   (html :type (string :max 100000) :input nil) (sender :type json :input nil)
   (recipient :type message-recipient-type :input nil) (scheduled-at :type timestamp :input nil)
   (sent-at :type timestamp :input nil) (created-at :type timestamp :input nil)
   (status :type (enum "planlagt" "sendt") :input nil :initform "planlagt")
   (employee-id :type id :input nil) (request-id :type id :input nil)))
(defun delivery-rollback-check (record)
  (declare (ignore record))
  "an immutable delivery exists; the older messaging module lacks the outbox and its outcomes")
(define-entity delivery (:label "E-postleveranse" :id-prefix "dlv" :table "deliveries" :unique (("message_id") ("idempotency_key"))
                         :rollback-check delivery-rollback-check)
  ((message-id :type id :input nil)
   (status :type (enum "queued" "sending" "accepted" "failed" "outcome_unknown") :input nil :initform "queued")
   (attempt-count :type integer :input nil :initform 0) (transition-version :type integer :input nil :initform 0)
   (idempotency-key :type (string :max 500) :input nil) (provider :type string :input nil)
   (provider-message-id :type string :input nil) (error-code :type string :input nil)
   (safe-error-message :type string :input nil) (queued-at :type timestamp :input nil)
   (sending-started-at :type timestamp :input nil) (accepted-at :type timestamp :input nil)
   (failed-at :type timestamp :input nil) (resolved-by :type string :input nil) (resolution-note :type string :input nil)
   (job-id :type id :input nil :label "Jobb" :description "The send_delivery job that makes its provider call.")))
(defmethod entity->json :around ((item message))
  (let ((json (call-next-method)))
    (setf (gethash "delivery" json) (let ((row (and (entity-id item) (select-one 'delivery :where `(:= "message_id" ,(entity-id item))))))
                                      (if row (entity->json row) :null))) (mask-quote-credentials json (message-order-id item))))
(defclass message-transport () ())
(defgeneric deliver-message (transport message))
(defclass fake-message-transport (message-transport) ())
(defmethod deliver-message ((transport fake-message-transport) message)
  (setf (message-status message) "sendt" (message-sent-at message) (now)) message)

(defun message-date (date)
  (if date (format nil "~a.~a.~a" (subseq date 8 10) (subseq date 5 7) (subseq date 0 4)) "dato ikke fastsatt"))
(defun message-money (ore)
  (let* ((digits (write-to-string (floor ore 100)))
         (whole (with-output-to-string (out)
                  (loop for c across digits for i from 0 do
                    (when (and (plusp i) (zerop (mod (- (length digits) i) 3))) (write-char #\Space out)) (write-char c out)))))
    (format nil "~a,~2,'0d kr" whole (mod ore 100))))
(defun message-period (order)
  (if (and (order-end-date order) (not (equal (order-end-date order) (order-event-date order))))
      (format nil "~a–~a" (message-date (order-event-date order)) (message-date (order-end-date order)))
      (message-date (order-event-date order))))
(defun message-instant (time)
  (format nil "~a kl. ~a" (message-date (local-date-of time)) (local-time-of time)))
(defun message-sender-snapshot ()
  (let ((email (setting-value-at-use "avsender.epost")))
    (jobj "name" (setting-value-at-use "avsender.navn") "email" email "reply_to" (or (setting-value-at-use "avsender.svar_til") email))))
(defun message-context (order customer text)
  (let ((context (jobj)) (sender (message-sender-snapshot)))
    (flet ((put (key value) (setf (gethash key context) value)))
      (put "avsender.navn" (jget sender "name")) (put "avsender.epost" (jget sender "email"))
      (put "melding" (or text "Ta kontakt ved å svare på denne e-posten hvis noe må avklares."))
      (when (and customer (not (customer-erased customer)))
        (put "kunde.navn" (if (blank-p (customer-name customer)) "Kunde" (customer-name customer))) (put "kunde.epost" (customer-email customer))
        (put "lenke.avmeld" (format nil "~a/avmeld/~a" (setting-value-at-use "lenker.base_url") (link-token "avmeld" (entity-id customer)))))
      (when order
        (put "ordre.id" (entity-id order)) (put "ordre.ref" (format nil "ref:~a" (entity-id order)))
        (put "ordre.dato" (message-date (order-event-date order))) (put "ordre.periode" (message-period order))
        (put "ordre.sted" (or (order-delivery-address order) ""))
        (put "ordre.sted_suffix" (if (blank-p (order-delivery-address order)) "" (format nil " på ~a" (order-delivery-address order))))
        (put "ordre.linjer" (join-strings (mapcar (lambda (line)
            (format nil "~a · ~d: ~a" (tun.catalog:product-name (tun.catalog:find-product (order-line-product-id line)))
                    (order-line-quantity line) (message-money (or (order-line-line-effective-ore line) (order-line-line-total-ore line)))))
                                                (order-lines order)) (string #\Newline)))
        (put "ordre.total" (message-money (order-total-ore order)))
        (let* ((logistics (order-logistics-object order)) (side (jget logistics "delivery")) (earliest (jget side "earliest")))
          (put "levering.tid" (if (and (stringp earliest) (not (blank-p earliest))) (format nil "kl. ~a" earliest) "ikke avtalt"))
          (put "levering.adresse" (if (blank-p (order-delivery-address order)) "adressen dere oppga" (order-delivery-address order)))
          (put "levering.metode" (or (jget side "method") "")))
        (put "bruksanvisninger_avsnitt" (let ((manuals (remove nil (mapcar (lambda (line)
          (let ((p (tun.catalog:find-product (order-line-product-id line))))
            (when (and (tun.catalog:rental-product-p p) (tun.catalog:product-manual-url p))
              (format nil "~a: ~a" (tun.catalog:product-name p) (tun.catalog:product-manual-url p))))) (order-lines order)))))
          (if manuals (format nil "Digital bruksanvisning:~%~a~%~%" (join-strings manuals (string #\Newline))) "")))
        (put "lenke.tilbakemelding" (format nil "~a/tilbakemelding/~a" (setting-value-at-use "lenker.base_url") (link-token "tilbakemelding" (entity-id order))))
        (let ((quote (quote-for-order (entity-id order))))
          (when quote
            (let* ((q (entity->json quote)) (code (jget q "access_code")))
              (put "tilbud.lenke" (format nil "~a/tilbud/~a" (setting-value-at-use "lenker.base_url") (entity-id quote)))
              (put "tilbud.kode" (format nil "~a-~a" (subseq code 0 5) (subseq code 5)))
              (put "tilbud.gyldig_til" (message-instant (parse-rfc3339 (jget q "expires_at")))))))
        (put "tilbud.spørsmål_avsnitt" (if (order-open-questions order)
          (format nil "Vi mangler noen opplysninger:~%~{- ~a~%~}~%" (order-open-questions order)) "")))
      (let ((url (setting-value-at-use "anmeldelse.url")))
        (put "anmeldelse_avsnitt" (if url (format nil "Ellers setter vi stor pris på en aldri så liten anbefaling:~%~a~%~%" url) "")))) context))
(defun render-placeholders (text context variables)
  (cl-ppcre:regex-replace-all "\\{\\{([^}]+)\\}\\}" text
    (lambda (target start end match-start match-end register-starts register-ends)
      (declare (ignore start end match-start match-end))
      (let* ((path (subseq target (aref register-starts 0) (aref register-ends 0))) (value (gethash path context)))
        (when (and (member path variables :test #'equal) (null value)) (fail :invalid-input "template_variable_missing: ~a" path))
        (if value (princ-to-string value) "")))))
(defun escaped-message-html (text)
  (let* ((escaped (tun.web:escape-html text))
         (linked (cl-ppcre:regex-replace-all "https?://[^ <\\n]+" escaped "<a href=\"\\&\">\\&</a>")))
    (format nil "~{<p>~a</p>~}" (mapcar (lambda (p) (cl-ppcre:regex-replace-all (string #\Newline) p "<br>")) (cl-ppcre:split "\\n\\n" linked)))))
(defun validated-message-copy (value text)
  (let* ((normal (normalize-message-text (if text (cl-ppcre:regex-replace-all "\\r\\n?" value (string #\Newline)) value)))
         (copy (trim normal))
         (graphemes (message-grapheme-count copy)))
    (when (some (lambda (c) (let ((n (char-code c))) (and (or (< n 32) (<= 127 n 159)) (not (and text (member c '(#\Tab #\Newline))))))) normal)
      (fail :invalid-input (if text "Meldingsteksten inneholder et kontrolltegn som ikke er tillatt" "Emnet kan ikke inneholde linjeskift eller kontrolltegn")))
    (when (blank-p copy) (fail :invalid-input "Emne og meldingstekst må fylles ut"))
    (when (or (> graphemes (if text 4000 200)) (> (utf8-byte-count copy) (if text 16000 800)))
      (fail :invalid-input (if text "Meldingsteksten kan være opptil 4000 tegn eller 16 000 byte" "Emnet kan være opptil 200 tegn eller 800 byte"))) copy))
(defun render-message-snapshot (name order customer &key subject text manual)
  (let ((tpl (or (find-message-template name) (fail :not-found "Malen finnes ikke"))))
    (when (and (message-template-marketing-p tpl) (not (marketing-allowed-p customer))) (fail :invalid-input "kunden har ikke samtykket til markedsføring"))
    (when (and manual (customer-erased customer)) (fail :invalid-input "kunden er slettet"))
    (when (and manual (not (message-template-manual-p tpl))) (fail :invalid-input "Malen kan ikke sendes manuelt"))
    (when (and (equal name "ordremelding") (not (eq (actor-role *actor*) :admin))) (reject :forbidden "Ordremelding krever admin"))
    (when (and text (not (equal name "ordremelding"))) (fail :invalid-input "Tekst kan bare endres for ordremelding"))
    (let* ((copy (and text (validated-message-copy text t))) (context (message-context order customer copy))
           (rendered-subject (if (message-template-text tpl) (render-placeholders (message-template-subject tpl) context (message-template-variables tpl))
                                (nth-value 0 (render-message-template name :order order :customer customer))))
           (body (if (message-template-text tpl) (render-placeholders (message-template-text tpl) context (message-template-variables tpl))
                     (nth-value 1 (render-message-template name :order order :customer customer))))
           (subj (if subject (validated-message-copy subject nil) rendered-subject))
           (recipient (jobj "name" (customer-name customer) "email" (customer-email customer))) (sender (message-sender-snapshot)))
      (when order (setf subj (format nil "~a [ref:~a]" subj (entity-id order))))
      (let* ((snapshot (jobj "template" name "version" (message-template-version tpl) "recipient" recipient "sender" sender "subject" subj "body" body
                            "order_revision" (if order (order-revision order) :null) "customer_revision" (customer-revision customer)))
             (result (json-copy snapshot)))
        (remhash "order_revision" result) (remhash "customer_revision" result)
        (setf (gethash "html" result) (escaped-message-html body) (gethash "variables" result) context (gethash "snapshot_hash" result) (canonical-json-hash snapshot)) result))))
(defun enqueue-message-snapshot (snapshot order customer key)
  (let ((existing (select-one 'delivery :where `(:= "idempotency_key" ,key))))
    (when existing (return-from enqueue-message-snapshot (fetch! 'message (delivery-message-id existing)))))
  (let ((item (insert (make-instance 'message :order-id (and order (entity-id order)) :customer-id (entity-id customer)
                       :template (jget snapshot "template") :version (jget snapshot "version") :subject (jget snapshot "subject")
                       :body (jget snapshot "body") :html (jget snapshot "html") :sender (jget snapshot "sender") :recipient (jget snapshot "recipient")
                       :scheduled-at (now) :sent-at (now) :created-at (now) :status "sendt" :request-id *request-id*))))
    (queue-delivery-job (insert (make-instance 'delivery :message-id (entity-id item) :idempotency-key key :queued-at (now)))) item))
(defun send-message (template &rest context &key order customer employee-id recipient (scheduled-at (now)) &allow-other-keys)
  "Queue a frozen customer snapshot atomically; staff transports retain their established contract."
  (if employee-id
      (multiple-value-bind (subject body) (apply #'render-message-template template context)
        (let ((item (insert (make-instance 'message :employee-id employee-id :recipient recipient :template template :subject subject :body body
                                          :scheduled-at scheduled-at :created-at (now) :request-id *request-id*))))
          (deliver-message (or (application-message-transport *application*) (make-instance 'fake-message-transport)) item) (save item)))
      (let ((tpl (find-message-template template)))
        (when (and tpl (message-template-marketing-p tpl) (not (marketing-allowed-p customer)))
          (when tun.workflows:*running-workflow*
            (tun.workflows:note-workflow-run "kunden har ikke samtykket til markedsføring"))
          (return-from send-message nil))
        (let* ((snapshot (render-message-snapshot template order customer))
               (key (format nil "~a:~a:~a" template (entity-id (or order customer))
                            (or (and tun.workflows:*running-workflow*
                                     (let ((wf (fetch 'tun.workflows:workflow tun.workflows:*running-workflow*)))
                                       (or (tun.workflows:workflow-key wf) (entity-id wf))))
                                (jget snapshot "snapshot_hash")))))
          (enqueue-message-snapshot snapshot order customer key)))))
(register-message-sender 'send-message)
(defun message-target (name order-id customer-id)
  (unless (and (or order-id customer-id) (not (and order-id customer-id))) (fail :invalid-input "Oppgi enten ordre eller kunde"))
  (when (and (null order-id) (not (equal name "neste_år"))) (fail :invalid-input "Malen krever en ordre"))
  (let ((order (and order-id (find-order order-id)))) (values order (if order (order-customer order) (fetch! 'customer customer-id)))))
(define-operation templates-list () (:entity template :kind :read :title "Meldingsmaler")
  (jobj "items" (jarr (mapcar #'message-template-description (sort (copy-list *message-templates*) #'string< :key #'message-template-name)))))
(defun message-preview-snapshot (snapshot order)
  "Mask credentials on a copy; the hash continues to cover the complete stored snapshot."
  (let ((preview (mask-quote-credentials (json-copy snapshot) (and order (entity-id order)))))
    (setf (gethash "snapshot_hash" preview) (jget snapshot "snapshot_hash"))
    preview))
(define-operation messages-preview ((template :type string :required t) (order-id :type id) (customer-id :type id)
                                    (subject :type (string :max 5000 :trim nil)) (text :type (string :max 20000 :trim nil)))
    (:entity message :kind :read :policy :employee :title "Forhåndsvis melding")
  (multiple-value-bind (order customer) (message-target template order-id customer-id)
    (message-preview-snapshot (render-message-snapshot template order customer :subject subject :text text :manual t) order)))
(define-operation messages-send ((template :type string :required t) (order-id :type id) (customer-id :type id)
                                 (subject :type (string :max 5000 :trim nil)) (text :type (string :max 20000 :trim nil)) (snapshot-hash :type string :required t))
    (:entity message :kind :create :policy :employee :title "Legg melding i kø")
  (multiple-value-bind (order customer) (message-target template order-id customer-id)
    (let ((snapshot (render-message-snapshot template order customer :subject subject :text text :manual t)))
      (unless (equal snapshot-hash (jget snapshot "snapshot_hash")) (fail :conflict "Forhåndsvisningen er utdatert. Åpne en ny forhåndsvisning før du sender."))
      (enqueue-message-snapshot snapshot order customer (format nil "~a:~a:~a" template (entity-id (or order customer)) snapshot-hash)))))
(defun communication-history (&key order-id customer-id template kind)
  "Complete actor-safe history, oldest first; callers choose their own page."
  (with-transaction (:read)
  (let* ((where (remove nil (list (and order-id `(:= "order_id" ,order-id)) (and customer-id `(:= "customer_id" ,customer-id)) (and template `(:= "template" ,template)))))
         (out (unless (equal kind "innkommende") (mapcar #'entity->json (select 'message :where (and where `(:and ,@where))))))
         (in (unless (or template (equal kind "utgående")) (inbox-history :order-id order-id :customer-id customer-id))))
    (dolist (item in) (mask-quote-credentials item (jget item "order_id")))
    (stable-sort (append out in) #'string< :key (lambda (message) (jget message "scheduled_at"))))))
(define-operation messages-list ((order-id :type id) (customer-id :type id) (template :type string)
                                 (kind :type (enum "utgående" "innkommende")) (limit :type (integer :min 1 :max 100) :default 20))
    (:entity message :kind :read :title "Meldinger")
  (let ((all (communication-history :order-id order-id :customer-id customer-id :template template :kind kind)))
    (jobj "items" (jarr (subseq all 0 (min limit (length all)))))))
(define-operation messages-get ((id :type id :required t)) (:entity message :kind :read :title "Hent melding")
  (or (fetch 'message id) (find id (communication-history :kind "innkommende") :key (lambda (m) (jget m "id")) :test #'equal) (fail :not-found "Meldingen finnes ikke")))
(defmethod aggregate-order-communication ((app messaging-module) order)
  (let* ((result (call-next-method)) (items (select 'message :where `(:= "order_id" ,(entity-id order))))
         (latest (reduce #'max items :key #'message-scheduled-at :initial-value 0)))
    (setf (gethash "outbound" result) (length items)
          (gethash "failed" result) (count-if (lambda (m) (let ((d (select-one 'delivery :where `(:= "message_id" ,(entity-id m)))))
                                                         (and d (member (delivery-status d) '("failed" "outcome_unknown") :test #'equal)))) items))
    (when (plusp latest) (setf (gethash "last_outbound_at" result) (format-rfc3339 latest))) result))
(defmethod customer-erasing ((app messaging-module) customer)
  (call-next-method)
  (dolist (item (select 'message :where `(:= "customer_id" ,(entity-id customer))))
    (setf (message-recipient item) (jobj "name" "[slettet]" "email" "[slettet]") (message-subject item) "[slettet]"
          (message-body item) "[slettet]" (message-html item) "[slettet]") (save item) (redact-entity-receipts item)))
(define-message-template default-quote-message (:template "tilbud" :label "Tilbud (standard)"
  :subject "Tilbud" :text "Hei {{kunde.navn}}, her er tilbudet ditt: {{ordre.total}}." :variables ("kunde.navn" "ordre.total")) (&key order customer))
(define-message-template default-invoice-message (:template "faktura" :label "Faktura (standard)") (&key order customer)
  (values "Faktura" (format nil "Hei ~a! Fakturaen for ordre ~a, totalt ~a kr, er sendt."
                           (customer-name customer) (entity-id order) (format-kroner (order-total-ore order)))))
(define-message-template default-warehouse-alert (:template "lagervarsel" :label "Lagervarsel (standard)") (&key suggestions)
  (values "Lagervarsel: varer som mangler" (format nil "Du mangler varer:~{ ~a~}" (map 'list (lambda (s) (jget s "name")) suggestions))))
(publish '(send-message message-status messages-preview messages-send messages-list))

(defun repair-message-receipts ()
  "At startup, redact receipts of erased customers' messages that still hold
their data (README §12); keys remain deduplicated."
  (with-transaction (:write)
    (dolist (customer (select 'customer :where '(:= "erased" t)))
      (dolist (item (select 'message :where `(:= "customer_id" ,(entity-id customer))))
        (redact-entity-receipts item)))))
